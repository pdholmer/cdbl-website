              "type": "string"
            },
            "team": {
              "description": "Team name substring to filter by.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_facilities",
        "title": "List facilities and field status",
